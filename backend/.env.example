# Copy to backend/.env and adjust. All keys map to app/config.py (case-insensitive).
GCP_PROJECT=aibuildercupprj
GCP_LOCATION=global
LLM_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001
EMBEDDER=vertex            # vertex | fake (offline)

VECTOR_STORE=memory        # memory | omni | alloydb
# ALLOYDB_INSTANCE_URI=projects/aibuildercupprj/locations/us-central1/clusters/second-brain/instances/primary
# ALLOYDB_PASSWORD=...
# OMNI_PASSWORD=...        # AlloyDB Omni postgres password (setup_omni.ps1 copies it to Secret Manager)
# OMNI_HOST=localhost       # local runs go through the IAP tunnel: OMNI_PORT=15432
# OMNI_PORT=15432

STATE_STORE=memory         # memory | firestore (approvals, audit log, inboxes, org graph)

# Integration adapters: mock | real (chat also: firebase = Firestore inbox + FCM web push)
JIRA_ADAPTER=mock
CHAT_ADAPTER=mock
CALENDAR_ADAPTER=mock
MONITORING_ADAPTER=mock

AUTH_PROVIDER=demo         # demo | firebase
JWT_SECRET=change-me       # demo auth only
# Firebase (AUTH_PROVIDER=firebase / CHAT_ADAPTER=firebase):
# FIREBASE_SIGNER_SA=second-brain-sa@aibuildercupprj.iam.gserviceaccount.com
# FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","appId":"...","messagingSenderId":"..."}
