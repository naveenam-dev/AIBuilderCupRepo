# Copy to backend/.env and adjust. All keys map to app/config.py (case-insensitive).
GCP_PROJECT=aibuildercupprj
GCP_LOCATION=global
LLM_MODEL=gemini-3.5-flash
EMBED_MODEL=gemini-embedding-001
EMBEDDER=vertex            # vertex | fake (offline)

VECTOR_STORE=memory        # memory | alloydb
# ALLOYDB_INSTANCE_URI=projects/aibuildercupprj/locations/us-central1/clusters/second-brain/instances/primary
# ALLOYDB_PASSWORD=...

# Integration adapters: mock | real
JIRA_ADAPTER=mock
CHAT_ADAPTER=mock
CALENDAR_ADAPTER=mock
MONITORING_ADAPTER=mock

JWT_SECRET=change-me
